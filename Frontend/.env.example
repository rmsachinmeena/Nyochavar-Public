# Backend API base URL
VITE_API_URL=http://localhost:5000/api
# Socket.io server URL (usually the backend origin)
VITE_SOCKET_URL=http://localhost:5000

# Google sign-in (optional, button is skipped when empty)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Firebase web config (optional, used for phone auth)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Concierge WhatsApp shown on seller pages: digits only, with country code
VITE_CONCIERGE_WHATSAPP=919999999999
VITE_CONCIERGE_DISPLAY=+91 99999 99999
