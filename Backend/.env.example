# ---- Server ----
# Port the API listens on
PORT=5000
# development | production
NODE_ENV=development
# Allowed browser origin for CORS (the Frontend URL)
FRONTEND_ORIGIN=http://localhost:9000
# Public Frontend URL used in emails and links
FRONTEND_URL=http://localhost:9000
# Set to 1 when running behind a reverse proxy (Render, Vercel, nginx)
TRUST_PROXY=0

# ---- Database (Supabase) ----
# Project URL from the Supabase dashboard
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key (server only, never expose to the browser)
SUPABASE_KEY=your_supabase_service_role_key

# ---- Auth: each role has its own JWT secret, 32+ chars, all different ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_BUYER_SECRET=replace_with_random_32_plus_chars_buyer
JWT_ADMIN_SECRET=replace_with_random_32_plus_chars_admin
JWT_RIDER_SECRET=replace_with_random_32_plus_chars_rider
# Optional: separate secret for sellers (falls back to a key derived from the admin secret)
JWT_SELLER_SECRET=
# Access and refresh token lifetimes in seconds (optional)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Password the super admin can use to open a seller panel (min 8 chars)
SELLER_MASTER_PASSWORD=change_me_demo_password
# Share of each sale kept by the platform, e.g. 0.12 = 12% (optional)
SELLER_COMMISSION_RATE=0.12

# ---- Google sign-in (optional) ----
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ---- Payments (Razorpay) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Secret set on the Razorpay webhook, used to verify the HMAC signature
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ---- Images (Cloudinary) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---- Email: use ONE of SMTP, Resend, or the relay below ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
# For Gmail use an app password
SMTP_PASS=your_smtp_app_password
EMAIL_FROM="Nyochavar <no-reply@example.com>"
# Resend API key (for hosts that block SMTP ports)
RESEND_API_KEY=
# Optional relay: URL and shared key of another server that sends mail over SMTP
EMAIL_API_URL=
EMAIL_API_KEY=

# ---- Admin alerts (comma separated) ----
ADMIN_ALERT_EMAILS=owner@example.com
ADMIN_ALERT_PHONES=9876543210

# ---- WhatsApp bot (Baileys) ----
# true = reconnect the bot automatically on start
WHATSAPP_AUTO_RESUME=false
